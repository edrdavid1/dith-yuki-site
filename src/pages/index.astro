---
import Layout from "../layouts/Layout.astro";
import {
  DEFAULT_IMAGE_ALT,
  DEFAULT_SITE_DESCRIPTION,
  softwareApplicationSchema,
} from "../lib/seo";

const description = DEFAULT_SITE_DESCRIPTION;

const softwareSchema = softwareApplicationSchema(Astro.site, description);

const capabilities = [
  [
    "Algorithms",
    "25+ methods — ordered, error-diffusion, halftone, stipple, ASCII, CRT, and experimental patterns",
  ],
  ["Color Lab", "Palettes, quantization, harmonies, and ramps"],
  ["Layers", "Non-destructive stacks, opacity, and blend modes"],
  ["Export", "PNG, JPG, WEBP, BMP, TIFF, SVG, and ASCII formats"],
];
---

<Layout
  title="Dither Yuki — Image Dithering & ASCII Art Studio"
  description={description}
  image="/social-card.png"
  imageAlt={DEFAULT_IMAGE_ALT}
  schema={softwareSchema}
>
  <section slot="hero" class="hero" aria-labelledby="page-title">
    <img
      class="hero-art"
      src="/images/hero-bg.webp"
      alt=""
      width="1512"
      height="988"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-grain" aria-hidden="true"></div>

    <div class="hero-stack">
      <h1 id="page-title">dither <em>yuki</em></h1>
      <a class="hero-mark" href="#nav" aria-label="Scroll to navigation">
        <img
          src="/images/hero-icon.svg"
          alt=""
          width="366"
          height="346"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <div
    class="home-mobile-actions"
    role="group"
    aria-label="Download Dither Yuki and visit GitHub"
  >
    <button
      type="button"
      class="nav-btn"
      data-open-dialog="download-mac"
      aria-haspopup="dialog"
    >
      <span>Download for Mac</span>
      <img
        src="/images/macos.webp"
        alt=""
        aria-hidden="true"
        width="42"
        height="42"
      />
    </button>
    <button
      type="button"
      class="nav-btn"
      data-open-dialog="download-windows"
      aria-haspopup="dialog"
    >
      <span>Download for Windows</span>
      <img
        src="/images/windows.webp"
        alt=""
        aria-hidden="true"
        width="42"
        height="42"
      />
    </button>
    <a
      class="nav-btn"
      href="https://github.com/edrdavid1/dith-yuki"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>GitHub</span>
      <svg viewBox="0 0 42 42" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M21 4.5a16.7 16.7 0 0 0-5.3 32.6c.8.2 1.1-.3 1.1-.8v-3c-4.5 1-5.5-1.9-5.5-1.9-.7-1.8-1.8-2.3-1.8-2.3-1.5-1 .1-1 .1-1 1.6.1 2.4 1.7 2.4 1.7 1.5 2.4 3.8 1.7 4.8 1.3.2-1 .6-1.7 1-2.1-3.6-.4-7.4-1.8-7.4-8.1 0-1.8.6-3.2 1.7-4.4-.2-.4-.7-2.1.2-4.4 0 0 1.4-.4 4.6 1.7a16 16 0 0 1 8.4 0c3.2-2.1 4.6-1.7 4.6-1.7.9 2.3.4 4 .2 4.4 1.1 1.2 1.7 2.6 1.7 4.4 0 6.3-3.8 7.7-7.4 8.1.6.5 1.1 1.5 1.1 3v4.4c0 .5.3 1 1.1.8A16.7 16.7 0 0 0 21 4.5Z"
        ></path></svg
      >
    </a>
  </div>

  <div class="page">
    <section
      id="what-is-it"
      class="block intro reveal reveal-stagger"
      aria-labelledby="what-title"
    >
      <figure class="intro-media">
        <img
          class="intro-media-back"
          src="/images/img_b.webp"
          alt="Dithered sunflower rendered in a limited palette"
          width="1612"
          height="1558"
          loading="lazy"
          decoding="async"
        />
        <img
          class="intro-media-front"
          src="/images/img_f.webp"
          alt=""
          width="1612"
          height="1558"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </figure>

      <div class="intro-text">
        <p class="kicker">01 — Product</p>
        <h2 id="what-title">What is it</h2>
        <p class="lead">
          Dither Yuki is a desktop image dithering studio for turning photos
          into dithered art and ASCII images. Experiment with ordered and
          error-diffusion dithering, build color palettes, and create halftone,
          stipple, and pixel-style results.
        </p>
        <p>
          Explore dithering algorithms, build palettes, experiment with halftone
          and stipple effects, and keep everything organized in layers.
        </p>
      </div>
    </section>

    <section
      id="features"
      class="block features reveal reveal-stagger"
      aria-labelledby="features-title"
    >
      <div class="features-head">
        <p class="kicker">02 — Tools</p>
        <h2 id="features-title">What we have</h2>
        <p class="lead">
          A focused studio for dithering, palettes, and digital image play — not
          a bloated production suite.
        </p>
      </div>

      <ul class="feature-grid">
        {
          capabilities.map(([name, detail]) => (
            <li>
              <strong>{name}</strong>
              <span>{detail}</span>
            </li>
          ))
        }
      </ul>

      <p class="features-more">
        <a href="/review/">Read the full review →</a>
      </p>
    </section>

    <section
      id="project"
      class="block about reveal reveal-stagger"
      aria-labelledby="about-title"
    >
      <p class="kicker">03 — Maker</p>
      <h2 id="about-title">Who we are</h2>
      <div class="about-body">
        <p>
          Hi, I'm Dave — an artist and indie developer behind L'eco non di
          Bergamo.¹ I couldn't find a convenient tool for image dithering that
          suited my needs, so I decided to make my own. This project started as
          a personal tool that I want to keep developing and improving over
          time.
        </p>
        <p id="license">
          Right now, my budget is very limited, so I can't afford the necessary
          developer accounts and licenses for macOS and Windows. Because of
          this, installing the app may come with additional security warnings.
        </p>
        <p>
          If you like the project and want to help me make it better and keep
          developing it, you can support me through Ko-fi. Thanks for trying out
          my project!
        </p>
      </div>
      <div class="support-cta">
        <a
          class="coffee-link"
          href="https://ko-fi.com/ditheryuki"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M4 8h13v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Zm13 2h2a2 2 0 1 1 0 4h-2M7 4c0 1 1 1 1 2m4-2c0 1 1 1 1 2"
            ></path></svg
          >
          Ko-fi
        </a>
        <details class="support-notice">
          <summary>
            <span class="support-notice-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14">
                <circle
                  cx="8"
                  cy="8"
                  r="6.25"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"></circle>
                <path
                  d="M8 7.25v3.5M8 5.2v.2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.35"
                  stroke-linecap="round"></path>
              </svg>
            </span>
            <span>Terms &amp; Non-Commercial Notice</span>
          </summary>
          <div class="support-notice-body">
            <p>
              This is a personal, non-commercial source-available project. The
              source code is licensed under the{" "}
              <a href="/license/">L'eco non di Bergamo Software License</a>,
              which restricts commercial redistribution and incorporation into
              other products.
            </p>
            <p>
              All contributions through Ko-fi (or PayPal) are voluntary,
              non-refundable gifts supporting this free tool; no goods, premium
              services, hidden features, or exclusive benefits are provided in
              return. Thank you for keeping this project alive!
            </p>
          </div>
        </details>
      </div>
      <figure class="about-media">
        <img
          src="/images/face-dithering.webp"
          alt="Dithered portrait showing the Dither Yuki visual style"
          width="748"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <p class="signature reveal">
      <span class="flag" aria-hidden="true"
        ><i class="blue"></i><i class="brown"></i><i class="dark"></i></span
      >
      <a
        href="https://t.me/leco_di_Bergamo"
        target="_blank"
        rel="noopener noreferrer"
      >
        L'eco non di Bergamo.<sup>1</sup>
      </a>
    </p>
  </div>

  <script>
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const back = document.querySelector(".intro-media-back");
    const supportsScrollTimeline =
      typeof CSS !== "undefined" &&
      typeof CSS.supports === "function" &&
      CSS.supports("animation-timeline: scroll()");
    // Touch / coarse pointers + JS style writes during scroll are a common
    // Safari jank source; keep the effect only when CSS can drive it.
    const coarsePointer = window.matchMedia("(pointer: coarse)").matches;

    if (
      !reduceMotion &&
      !supportsScrollTimeline &&
      !coarsePointer &&
      back instanceof HTMLElement
    ) {
      let ticking = false;
      let active = true;
      let maxScroll = 1;

      const measure = () => {
        maxScroll = Math.max(
          1,
          document.documentElement.scrollHeight - window.innerHeight,
        );
      };

      const update = () => {
        if (!active) {
          ticking = false;
          return;
        }
        const deg = (window.scrollY / maxScroll) * 360;
        back.style.transform = `translateZ(0) rotate(${deg}deg)`;
        ticking = false;
      };

      const onScroll = () => {
        if (ticking || !active) return;
        ticking = true;
        window.requestAnimationFrame(update);
      };

      const onResize = () => {
        measure();
        onScroll();
      };

      measure();
      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onResize, { passive: true });

      if ("IntersectionObserver" in window) {
        const figure = back.closest(".intro-media") ?? back;
        const observer = new IntersectionObserver(
          ([entry]) => {
            active = Boolean(entry?.isIntersecting);
            if (active) onScroll();
          },
          { rootMargin: "20% 0px" },
        );
        observer.observe(figure);
      }
    }
  </script>
</Layout>
