---
import Layout from "../layouts/Layout.astro";
import {
  DEFAULT_IMAGE_ALT,
  DEFAULT_SITE_DESCRIPTION,
  softwareApplicationSchema,
} from "../lib/seo";

const description = DEFAULT_SITE_DESCRIPTION;

const softwareSchema = softwareApplicationSchema(Astro.site, description);

const capabilities = [
  [
    "Algorithms",
    "25+ methods — ordered, error-diffusion, halftone, stipple, ASCII, CRT, and experimental patterns",
  ],
  ["Color Lab", "Palettes, quantization, harmonies, and ramps"],
  ["Layers", "Non-destructive stacks, opacity, and blend modes"],
  ["Export", "PNG, JPG, WEBP, BMP, TIFF, SVG, and ASCII formats"],
];
---

<Layout
  title="Dither Yuki — Image Dithering & ASCII Art Studio"
  description={description}
  image="/social-card.png"
  imageAlt={DEFAULT_IMAGE_ALT}
  schema={softwareSchema}
>
  <section slot="hero" class="hero" aria-labelledby="page-title">
    <img
      class="hero-art"
      src="/images/hero-bg.webp"
      alt=""
      width="1512"
      height="988"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-grain" aria-hidden="true"></div>

    <div class="hero-stack">
      <h1 id="page-title">dither <em>yuki</em></h1>
      <a class="hero-mark" href="#nav" aria-label="Scroll to navigation">
        <img
          src="/images/hero-icon.svg"
          alt=""
          width="366"
          height="346"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <div
    class="home-mobile-actions"
    role="group"
    aria-label="Download Dither Yuki"
  >
    <button
      type="button"
      class="nav-btn"
      data-open-dialog="download-mac"
      aria-haspopup="dialog"
    >
      <span>Download for Mac</span>
      <img
        src="/images/macos.webp"
        alt=""
        aria-hidden="true"
        width="42"
        height="42"
      />
    </button>
    <button
      type="button"
      class="nav-btn"
      data-open-dialog="download-windows"
      aria-haspopup="dialog"
    >
      <span>Download for Windows</span>
      <img
        src="/images/windows.webp"
        alt=""
        aria-hidden="true"
        width="42"
        height="42"
      />
    </button>
  </div>

  <div class="page">
    <section
      id="what-is-it"
      class="block intro reveal reveal-stagger"
      aria-labelledby="what-title"
    >
      <figure class="intro-media">
        <img
          class="intro-media-back"
          src="/images/img_b.webp"
          alt="Dithered sunflower rendered in a limited palette"
          width="1612"
          height="1558"
          loading="lazy"
          decoding="async"
        />
        <img
          class="intro-media-front"
          src="/images/img_f.webp"
          alt=""
          width="1612"
          height="1558"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </figure>

      <div class="intro-text">
        <h2 id="what-title">What is it</h2>
        <p class="lead">
          Dither Yuki is a desktop image dithering studio for turning photos
          into dithered art and ASCII images. Experiment with ordered and
          error-diffusion dithering, build color palettes, and create halftone,
          stipple, and pixel-style results.
        </p>
        <p>
          Explore dithering algorithms, build palettes, experiment with halftone
          and stipple effects, and keep everything organized in layers.
        </p>
      </div>
    </section>

    <section
      id="features"
      class="block features reveal reveal-stagger"
      aria-labelledby="features-title"
    >
      <div class="features-head">
        <h2 id="features-title">What we have</h2>
        <p class="lead">
          A focused studio for dithering, palettes, and digital image play — not
          a bloated production suite.
        </p>
      </div>

      <ul class="feature-grid">
        {
          capabilities.map(([name, detail]) => (
            <li>
              <strong>{name}</strong>
              <span>{detail}</span>
            </li>
          ))
        }
      </ul>

      <p class="features-more">
        <a href="/review/">Read the full review →</a>
      </p>
    </section>

    <section
      id="project"
      class="block about reveal reveal-stagger"
      aria-labelledby="about-title"
    >
      <h2 id="about-title">Who we are</h2>
      <div class="about-body">
        <p>
          A small studio in Lithuania. We build and ship our own apps, where
          engineering, design and play meet.
        </p>
      </div>
      <figure class="about-media">
        <img
          src="/images/face-dithering.webp"
          alt="Dithered portrait showing the Dither Yuki visual style"
          width="748"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <p class="signature reveal">
      <a
        class="studio-mark"
        href="https://vasdas.studio"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/studio-logo.svg"
          alt=""
          width="40"
          height="40"
          decoding="async"
        />
        <span>Vasdas studio</span>
      </a>
    </p>
  </div>

  <script>
    (() => {
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (reduceMotion) return;

      const back = document.querySelector<HTMLElement>(".intro-media-back");
      if (!back) return;

      let active = true;
      let maxScroll = 1;
      let currentDeg = 0;
      let targetDeg = 0;
      let rafId: number | null = null;

      const measure = () => {
        maxScroll = Math.max(
          1,
          document.documentElement.scrollHeight - window.innerHeight,
        );
      };

      const animate = () => {
        const diff = targetDeg - currentDeg;
        currentDeg += diff * 0.12;
        back.style.transform = `translate3d(0, 0, 0) rotate(${currentDeg}deg)`;
        if (Math.abs(diff) > 0.05 && active) {
          rafId = requestAnimationFrame(animate);
        } else {
          rafId = null;
        }
      };

      const onScroll = () => {
        if (!active) return;
        const scrollY = window.scrollY || window.pageYOffset || 0;
        targetDeg = (scrollY / maxScroll) * 360;
        if (rafId === null) {
          rafId = requestAnimationFrame(animate);
        }
      };

      measure();
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener(
        "resize",
        () => {
          measure();
          onScroll();
        },
        { passive: true },
      );

      if ("IntersectionObserver" in window) {
        const figure = back.closest(".intro-media") ?? back;
        const observer = new IntersectionObserver(
          ([entry]) => {
            active = Boolean(entry?.isIntersecting);
            if (active) onScroll();
          },
          { rootMargin: "25% 0px" },
        );
        observer.observe(figure);
      }
    })();
  </script>
</Layout>
