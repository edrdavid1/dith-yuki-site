---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  loading?: 'eager' | 'lazy';
  format?: 'avif' | 'webp';
  class?: string;
}

const { src, alt, width, height, loading = 'lazy', format = 'webp', class: className } = Astro.props;
---
<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  format={format}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
