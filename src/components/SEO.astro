---
import {
  DITHERING_KEYWORDS,
  DEFAULT_IMAGE_ALT,
  DEFAULT_SITE_DESCRIPTION,
  ORG_NAME,
  ORG_NAME_MARK,
  PERSON_NAME,
  SITE_NAME,
  organizationSchema,
  personSchema,
} from '../lib/seo';

interface SchemaNode {
  '@context'?: string;
  '@type': string;
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  locale?: string;
  robots?: string;
  keywords?: string;
  schema?: SchemaNode | SchemaNode[];
}

const {
  title,
  description,
  canonical,
  image = '/social-card.png',
  imageAlt = DEFAULT_IMAGE_ALT,
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  locale = 'en_US',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  keywords = DITHERING_KEYWORDS,
  schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : new URL(Astro.url.pathname, siteUrl);
// Strip cache-busting query params from share images.
const imagePath = image.split('?')[0] || '/social-card.png';
const imageUrl = new URL(imagePath, siteUrl);

const websiteSchema: SchemaNode = {
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: ['Dith Yuki', 'DitherYuki'],
  url: siteUrl.href,
  description: DEFAULT_SITE_DESCRIPTION,
  inLanguage: 'en',
  keywords: DITHERING_KEYWORDS,
  creator: personSchema(),
  publisher: organizationSchema(Astro.site),
  about: {
    '@type': 'Thing',
    name: 'Image dithering',
    description:
      'Ordered and error-diffusion dithering algorithms including Floyd–Steinberg, Atkinson, Bayer, Jarvis, Stucki, Sierra, Burkes, Riemersma, halftone, stipple, and ASCII art conversion.',
  },
};

const webPageSchema: SchemaNode = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl.href}#webpage`,
  url: canonicalUrl.href,
  name: title,
  description,
  keywords,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: siteUrl.href,
  },
  inLanguage: 'en',
  author: personSchema(),
  creator: personSchema(),
  publisher: organizationSchema(Astro.site),
  copyrightHolder: organizationSchema(Astro.site),
  copyrightYear: new Date().getFullYear(),
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: imageUrl.href,
    width: imageWidth,
    height: imageHeight,
    caption: imageAlt,
  },
};

const schemas = [
  websiteSchema,
  webPageSchema,
  personSchema(),
  organizationSchema(Astro.site),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

const jsonLd = (value: SchemaNode) =>
  JSON.stringify({ '@context': 'https://schema.org', ...value }).replace(/</g, '\\u003c');
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<meta name="author" content={`${PERSON_NAME} / ${ORG_NAME}`} />
<meta name="creator" content={PERSON_NAME} />
<meta name="publisher" content={ORG_NAME_MARK} />
<meta name="copyright" content={`© ${new Date().getFullYear()} ${PERSON_NAME}, ${ORG_NAME_MARK}`} />
<meta name="application-name" content={SITE_NAME} />
<meta name="apple-mobile-web-app-title" content={SITE_NAME} />
<meta name="generator" content={Astro.generator} />
<meta name="format-detection" content="telephone=no,address=no,email=no" />
<link rel="canonical" href={canonicalUrl.href} />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#ddd9ce" />
<meta name="color-scheme" content="light" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="author" href="/humans.txt" />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/android-chrome-192.png" type="image/png" sizes="192x192" />
<link rel="icon" href="/android-chrome-512.png" type="image/png" sizes="512x512" />
<link rel="apple-touch-icon" href="/favicon/180x180.png" sizes="180x180" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:secure_url" content={imageUrl.href} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="article:author" content={PERSON_NAME} />
<meta property="article:publisher" content={ORG_NAME} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:label1" content="Creator" />
<meta name="twitter:data1" content={PERSON_NAME} />
<meta name="twitter:label2" content="Studio" />
<meta name="twitter:data2" content={ORG_NAME_MARK} />

{schemas.map((item) => <script type="application/ld+json" set:html={jsonLd(item)} />)}
