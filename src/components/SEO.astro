---
interface SchemaNode {
  '@context'?: string;
  '@type': string;
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  locale?: string;
  robots?: string;
  schema?: SchemaNode | SchemaNode[];
}

const {
  title,
  description,
  canonical,
  image = '/social-card.png',
  imageAlt = 'Dither Yuki — desktop studio for dithering',
  type = 'website',
  locale = 'en_US',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const siteName = 'Dither Yuki';

const websiteSchema: SchemaNode = {
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl.href,
  description,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: "L'eco non di Bergamo",
    url: siteUrl.href,
    sameAs: [
      'https://github.com/edrdavid1/dith-yuki',
      'https://t.me/leco_di_Bergamo',
    ],
  },
};

const schemas = [
  websiteSchema,
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

const jsonLd = (value: SchemaNode) =>
  JSON.stringify({ '@context': 'https://schema.org', ...value }).replace(/</g, '\\u003c');
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<meta name="author" content="L'eco non di Bergamo" />
<meta name="generator" content={Astro.generator} />
<meta name="format-detection" content="telephone=no,address=no,email=no" />
<link rel="canonical" href={canonicalUrl.href} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ddd9ce" />
<meta name="color-scheme" content="light" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="icon" href="https://ditheryuki.com/android-chrome-192.png" type="image/png" sizes="192x192" />
<link rel="icon" href="https://ditheryuki.com/android-chrome-512.png" type="image/png" sizes="512x512" />
<link rel="icon" href="https://ditheryuki.com/favicon.ico" type="image/vnd.microsoft.icon" sizes="48x48" />
<link rel="apple-touch-icon" href="/images/favicon/180x180.png" sizes="180x180" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:secure_url" content={imageUrl.href} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="2768" />
<meta property="og:image:height" content="2804" />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={siteName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />

{schemas.map((item) => <script type="application/ld+json" set:html={jsonLd(item)} />)}
