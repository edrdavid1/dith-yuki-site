---
interface Props {
  title: string;
  titleId?: string;
  deck: string;
  note?: string;
}

const { title, titleId, deck, note } = Astro.props;
---

<header class="page-hero reveal">
  <div class="page-hero-mark" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>
  <h1 id={titleId}>{title}</h1>
  <p class="page-hero-deck">{deck}</p>
  {note && <p class="page-hero-note">{note}</p>}
  <slot />
</header>
