---
import '@fontsource/syne/400.css';
import '@fontsource/syne/500.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/iosevka/400.css';
import '@fontsource/iosevka/500.css';
import '@fontsource/iosevka/700.css';
import SEO from '../components/SEO.astro';
import DownloadDialog from '../components/DownloadDialog.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  schema?: Parameters<typeof SEO>[0]['schema'];
  robots?: string;
  variant?: 'home' | 'review' | 'dithering' | 'diary' | 'license' | 'not-found';
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  type = 'website',
  schema,
  robots,
  variant = 'home',
} = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      type={type}
      locale="en_US"
      schema={schema}
      robots={robots}
    />
  </head>
  <body class:list={[`${variant}-page`]}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="site">
      <header class="site-header" id="home">
        <slot name="hero" />

        <div class="chrome" id="nav">
          <nav class="site-nav" aria-label="Main navigation">
            <ul class="nav-links">
              <li>
                <a href="/" aria-current={variant === 'home' ? 'page' : undefined}>home</a>
              </li>
              <li>
                <a href="/review/" aria-current={variant === 'review' ? 'page' : undefined}>review</a>
              </li>
              <li>
                <a href="/dithering/" aria-current={variant === 'dithering' ? 'page' : undefined}>dithering</a>
              </li>
              <li>
                <a href="/diary/" aria-current={variant === 'diary' ? 'page' : undefined}>diary</a>
              </li>
              <li>
                <a href="/license/" aria-current={variant === 'license' ? 'page' : undefined}>license</a>
              </li>
            </ul>

            <div class="nav-buttons">
              <button
                type="button"
                class="nav-btn"
                data-open-dialog="download-mac"
                aria-haspopup="dialog"
              >
                <span>Download for Mac</span>
                <img src="/images/macos.webp" alt="" aria-hidden="true" width="42" height="42" />
              </button>
              <button
                type="button"
                class="nav-btn"
                data-open-dialog="download-windows"
                aria-haspopup="dialog"
              >
                <span>Download for Windows</span>
                <img src="/images/windows.webp" alt="" aria-hidden="true" width="42" height="42" />
              </button>
              <a class="nav-btn" href="https://github.com/edrdavid1/dith-yuki" target="_blank" rel="noopener noreferrer">
                <span>GitHub</span>
                <svg viewBox="0 0 42 42" aria-hidden="true"><path fill="currentColor" d="M21 4.5a16.7 16.7 0 0 0-5.3 32.6c.8.2 1.1-.3 1.1-.8v-3c-4.5 1-5.5-1.9-5.5-1.9-.7-1.8-1.8-2.3-1.8-2.3-1.5-1 .1-1 .1-1 1.6.1 2.4 1.7 2.4 1.7 1.5 2.4 3.8 1.7 4.8 1.3.2-1 .6-1.7 1-2.1-3.6-.4-7.4-1.8-7.4-8.1 0-1.8.6-3.2 1.7-4.4-.2-.4-.7-2.1.2-4.4 0 0 1.4-.4 4.6 1.7a16 16 0 0 1 8.4 0c3.2-2.1 4.6-1.7 4.6-1.7.9 2.3.4 4 .2 4.4 1.1 1.2 1.7 2.6 1.7 4.4 0 6.3-3.8 7.7-7.4 8.1.6.5 1.1 1.5 1.1 3v4.4c0 .5.3 1 1.1.8A16.7 16.7 0 0 0 21 4.5Z"/></svg>
              </a>
            </div>
          </nav>
        </div>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <img class="footer-art" src="/images/footer-bg.webp" alt="" width="1512" height="246" loading="lazy" decoding="async" />
        <div class="footer-panel">
          <div class="footer-meta">
            <p class="footer-brand">Dither Yuki</p>
            <p class="footer-copy">
              <span aria-hidden="true">©</span>
              <span class="sr-only">Copyright</span>
              {year} L'eco non di Bergamo.<sup>1</sup> All rights reserved.
            </p>
            <p class="footer-contact">
              <a href="mailto:support@ditheryuki.com">support@ditheryuki.com</a>
            </p>
          </div>
          <nav class="footer-nav" aria-label="Footer">
            <a href="/">Home</a>
            <a href="/review/">Review</a>
            <a href="/dithering/">Dithering</a>
            <a href="/diary/">Diary</a>
            <a href="/license/">License</a>
            <a href="https://github.com/edrdavid1/dith-yuki" target="_blank" rel="noopener noreferrer">GitHub</a>
          </nav>
        </div>
      </footer>
    </div>

    <DownloadDialog
      platform="mac"
      href="https://github.com/edrdavid1/dith-yuki/releases/download/v1.0.5-beta/Dither.Yuki_1.0.5-beta_aarch64.dmg"
    />
    <DownloadDialog
      platform="windows"
      href="https://github.com/edrdavid1/dith-yuki/releases/download/v1.0.5-beta/Dither.Yuki_1.0.5-beta_x64-setup.exe"
    />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealNodes = [...document.querySelectorAll<HTMLElement>('.reveal')];
      const planted = [...document.querySelectorAll<HTMLElement>('[data-reveal-with="footer"]')];
      const footer = document.querySelector<HTMLElement>('.site-footer');

      const reveal = (node: HTMLElement) => {
        if (node.classList.contains('is-visible')) return;
        node.style.willChange = 'opacity, transform';
        node.classList.add('is-visible');
        const clear = () => {
          node.style.willChange = 'auto';
        };
        node.addEventListener('transitionend', clear, { once: true });
        window.setTimeout(clear, 1400);
      };

      const revealPlanted = () => {
        planted.forEach((node) => reveal(node));
      };

      if (!reduce) {
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                reveal(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
          );

          revealNodes.forEach((node) => observer.observe(node));

          // Portrait stands on the footer — only appear once the footer is in view.
          if (footer && planted.length) {
            const footerGate = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  revealPlanted();
                  footerGate.disconnect();
                }
              },
              { threshold: 0.05, rootMargin: '0px 0px 0px 0px' },
            );
            footerGate.observe(footer);
          } else {
            revealPlanted();
          }
        } else {
          revealNodes.forEach((node) => reveal(node));
          revealPlanted();
        }
      } else {
        revealNodes.forEach((node) => node.classList.add('is-visible'));
        planted.forEach((node) => node.classList.add('is-visible'));
      }

      const homeHero = document.querySelector<HTMLElement>('.home-page .hero');
      if (homeHero) {
        const updateHomeNav = () => {
          const isMobile = window.matchMedia('(max-width: 720px)').matches;
          document.body.classList.toggle(
            'home-nav-visible',
            !isMobile || window.scrollY > 0,
          );
        };
        updateHomeNav();
        window.addEventListener('scroll', updateHomeNav, { passive: true });
        window.addEventListener('resize', updateHomeNav);

        const heroMark = document.querySelector<HTMLAnchorElement>('.hero-mark');
        heroMark?.addEventListener('click', (event) => {
          if (!window.matchMedia('(max-width: 720px)').matches) return;
          event.preventDefault();
          document.querySelector('.home-mobile-actions')?.scrollIntoView({
            behavior: reduce ? 'auto' : 'smooth',
            block: 'start',
          });
        });
      }

      const dialogs = [...document.querySelectorAll('dialog.dl-dialog')].filter(
        (node) => node instanceof HTMLDialogElement,
      );

      document.querySelectorAll('[data-open-dialog]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const id = trigger.getAttribute('data-open-dialog');
          const dialog = dialogs.find((item) => item.id === id);
          dialog?.showModal();
        });
      });

      document.querySelectorAll('[data-close-dialog]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dialog = btn.closest('dialog');
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      dialogs.forEach((dialog) => {
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
      });
    </script>
  </body>
</html>
