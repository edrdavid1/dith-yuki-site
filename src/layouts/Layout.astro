---
import '@fontsource/syne/400.css';
import '@fontsource/syne/500.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/iosevka/400.css';
import '@fontsource/iosevka/500.css';
import '@fontsource/iosevka/700.css';
import SEO from '../components/SEO.astro';
import DownloadDialog from '../components/DownloadDialog.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  schema?: Parameters<typeof SEO>[0]['schema'];
  robots?: string;
  variant?: 'home' | 'review' | 'license';
}

const { title, description, canonical, image, imageAlt, schema, robots, variant = 'home' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <SEO title={title} description={description} canonical={canonical} image={image} imageAlt={imageAlt} locale="en_US" schema={schema} robots={robots} />
  </head>
  <body class:list={[`${variant}-page`]}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="site">
      <header class="site-header" id="home">
        <slot name="hero" />

        <div class="chrome" id="nav">
          <nav class="site-nav" aria-label="Main navigation">
            <ul class="nav-links">
              <li>
                <a href="/" aria-current={variant === 'home' ? 'page' : undefined}>home</a>
              </li>
              <li>
                <a href="/review/" aria-current={variant === 'review' ? 'page' : undefined}>review</a>
              </li>
              <li>
                <a href="/license/" aria-current={variant === 'license' ? 'page' : undefined}>license</a>
              </li>
            </ul>

            <div class="nav-buttons">
              <button
                type="button"
                class="nav-btn"
                data-open-dialog="download-mac"
                aria-haspopup="dialog"
              >
                <span>Download for Mac</span>
                <img src="/images/macos.png" alt="" aria-hidden="true" width="42" height="42" />
              </button>
              <button
                type="button"
                class="nav-btn"
                data-open-dialog="download-windows"
                aria-haspopup="dialog"
              >
                <span>Download for Windows</span>
                <img src="/images/windows.png" alt="" aria-hidden="true" width="42" height="42" />
              </button>
              <a class="nav-btn" href="https://github.com/edrdavid1/dith-yuki" target="_blank" rel="noopener noreferrer">
                <span>GitHub</span>
                <svg viewBox="0 0 42 42" aria-hidden="true"><path fill="currentColor" d="M21 4.5a16.7 16.7 0 0 0-5.3 32.6c.8.2 1.1-.3 1.1-.8v-3c-4.5 1-5.5-1.9-5.5-1.9-.7-1.8-1.8-2.3-1.8-2.3-1.5-1 .1-1 .1-1 1.6.1 2.4 1.7 2.4 1.7 1.5 2.4 3.8 1.7 4.8 1.3.2-1 .6-1.7 1-2.1-3.6-.4-7.4-1.8-7.4-8.1 0-1.8.6-3.2 1.7-4.4-.2-.4-.7-2.1.2-4.4 0 0 1.4-.4 4.6 1.7a16 16 0 0 1 8.4 0c3.2-2.1 4.6-1.7 4.6-1.7.9 2.3.4 4 .2 4.4 1.1 1.2 1.7 2.6 1.7 4.4 0 6.3-3.8 7.7-7.4 8.1.6.5 1.1 1.5 1.1 3v4.4c0 .5.3 1 1.1.8A16.7 16.7 0 0 0 21 4.5Z"/></svg>
              </a>
            </div>
          </nav>
        </div>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer reveal">
        <img class="footer-art" src="/images/footer-bg.png" alt="" width="1512" height="246" loading="lazy" decoding="async" />
        <div class="footer-panel">
          <div class="footer-meta">
            <p class="footer-brand">Dither Yuki</p>
            <p class="footer-copy">
              <span aria-hidden="true">©</span>
              <span class="sr-only">Copyright</span>
              {year} L'eco non di Bergamo.<sup>1</sup> All rights reserved.
            </p>
          </div>
          <nav class="footer-nav" aria-label="Footer">
            <a href="/">Home</a>
            <a href="/review/">Review</a>
            <a href="/license/">License</a>
            <a href="https://github.com/edrdavid1/dith-yuki" target="_blank" rel="noopener noreferrer">GitHub</a>
          </nav>
        </div>
      </footer>
    </div>

    <DownloadDialog
      platform="mac"
      href="https://github.com/edrdavid1/dith-yuki/releases/download/v0.4.5-alpha/Dither.Yuki_0.4.5-alpha_aarch64.dmg"
    />
    <DownloadDialog
      platform="windows"
      href="https://github.com/edrdavid1/dith-yuki/releases/download/v0.4.5-alpha/Dither.Yuki_0.4.5-alpha_x64-setup.exe"
    />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = document.querySelectorAll('.reveal');

      if (!reduce) {
        const reveal = (node: HTMLElement) => {
          node.style.willChange = 'opacity, transform';
          node.classList.add('is-visible');
          const clear = () => {
            node.style.willChange = 'auto';
          };
          node.addEventListener('transitionend', clear, { once: true });
          window.setTimeout(clear, 1200);
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                reveal(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            },
            { threshold: 0.14, rootMargin: '0px 0px -8% 0px' },
          );
          nodes.forEach((node) => observer.observe(node));
        } else {
          nodes.forEach((node) => reveal(node as HTMLElement));
        }
      } else {
        nodes.forEach((node) => node.classList.add('is-visible'));
      }

      const dialogs = [...document.querySelectorAll('dialog.dl-dialog')].filter(
        (node) => node instanceof HTMLDialogElement,
      );

      document.querySelectorAll('[data-open-dialog]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const id = trigger.getAttribute('data-open-dialog');
          const dialog = dialogs.find((item) => item.id === id);
          dialog?.showModal();
        });
      });

      document.querySelectorAll('[data-close-dialog]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dialog = btn.closest('dialog');
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      dialogs.forEach((dialog) => {
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
      });
    </script>
  </body>
</html>
